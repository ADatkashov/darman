# Copy to .env (git-ignored). Placeholders only — never commit real secrets.

POSTGRES_PASSWORD=change-me-local-db-password

# Profile: "demo" (fictional data, demo adapters) for local use; "prod" for real deployments.
DARMAN_PROFILE=demo

# JWT signing secret, >= 32 chars (required in prod; empty in demo = random per start, sessions reset on restart).
DARMAN_JWT_SECRET=

# Demo only: shared password of the seeded demo accounts. Empty = random, printed once in the backend log.
DARMAN_DEMO_PASSWORD=
# Demo only: auto-"review" prescriptions (NOT a pharmacist verification). Keep false unless demonstrating.
DARMAN_DEMO_AUTO_REVIEW=false

# Production integrations (see docs/integrations.md)
DARMAN_PAYMENT_WEBHOOK_SECRET=
DARMAN_SMS_GATEWAY_URL=
DARMAN_SMS_API_KEY=
DARMAN_SMS_SENDER=DARMAN
DARMAN_CORS_ORIGINS=
DARMAN_PRIVACY_URL=
DARMAN_TERMS_URL=
DARMAN_SUPPORT_PHONE=
